SUPER_ADMIN_PASSWORD=replace-with-high-entropy-password-min-16-chars
SUPER_ADMIN_NAME=Super Admin
PUBLIC_INGEST_SECRET=replace-with-shared-ingest-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://hq.theasolutions.co,https://theasolutions.co
TRUST_PROXY=false
