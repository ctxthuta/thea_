PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/thea_hq?retryWrites=true&w=majority
MONGODB_DB_NAME=thea_hq
JWT_SECRET=replace-with-cryptographically-random-32-plus-byte-secret
