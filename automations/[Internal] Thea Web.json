      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nconst now = new Date();\n\nconst date = now.toLocaleDateString('en-CA', { \n    timeZone: 'Asia/Yangon' \n});\n\nconst time = now.toLocaleTimeString('en-US', { \n    timeZone: 'Asia/Yangon',\n    hour: '2-digit', \n    minute: '2-digit', \n    hour12: true \n});\n\nreturn [{\n  json: {\n    date: date,\n    time: time,\n    companyName: $input.first().json.body[0].company || '', \n    contactName: $input.first().json.body[0].contactName|| '', \n    emailAddress: $input.first().json.body[0].email|| '',  \n    mobile: $input.first().json.body[0].phone|| '',\n    serviceType: $input.first().json.body[0].serviceType|| '',  \n    projectDescription: $input.first().json.body[0].projectDescription|| '',\n    budgetRange:  $input.first().json.body[0].budgetRange|| '',\n    timeline: $input.first().json.body[0].timeline || '' \n  }\n}];"
      },
