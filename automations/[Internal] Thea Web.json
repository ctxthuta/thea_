    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst date = now.toLocaleDateString('en-CA', { timeZone: 'Asia/Yangon' }); \nconst time = now.toLocaleTimeString('en-US', { timeZone: 'Asia/Yangon', hour: '2-digit', minute: '2-digit', hour12: true });\n\nconst item = $input.first().json;\nconst d = item.body ?? item;\n\nreturn [{\n  json: {\n    requestedDate:  d.requestedDate  || date,\n    requestedTime:  d.requestedTime  || time,\n    name:           d.name           || '',\n    email:          d.email          || '',\n    phone:          d.phone != null ? `'${String(d.phone)}` : '',\n    businessDomain: d.businessDomain || '',\n    businessDescription: d.businessDescription || '',\n    scheduledDate:  d.scheduledDate  || '',\n    scheduledTime:  d.scheduledTime  || '',\n    productId:      d.productId      || '',\n    productName:    d.productName    || '',\n    productCategory:d.productCategory|| '',\n    referrer:       d.referrer || d.utm_source || 'direct',\n    utm_source:     d.utm_source    || '',\n    utm_medium:     d.utm_medium    || '',\n    utm_campaign:   d.utm_campaign  || ''\n  }\n}];"
      },
