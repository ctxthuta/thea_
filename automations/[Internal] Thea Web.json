      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst contact = Array.isArray(input.body) ? input.body[0] : (input.body ?? input);\n\nconst now = new Date();\n\nreturn [{\n  json: {\n    date: now.toLocaleDateString('en-CA', { timeZone: 'Asia/Yangon' }),\n    time: now.toLocaleTimeString('en-US', {\n      timeZone: 'Asia/Yangon',\n      hour: '2-digit',\n      minute: '2-digit',\n      hour12: true,\n    }),\n    email: contact.email ?? '',\n    phone: contact.phone ? `'${contact.phone}` : '',\n  },\n}];"
